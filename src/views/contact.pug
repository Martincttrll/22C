---
    template: "contact"
    title: "Contact | 22Carbone"  
---
extends ./_layouts/layout.pug
block content
    .contact
        .contact__wrapper
            h1.contact__title=prismic.contactpage.data.h1[0].text
            .contact__content__wrapper
                .contact__socials__wrapper
                    each social in prismic.contactpage.data.socials_list
                        a(href=social.social_link.url,target="_blank").contact__socials=social.social_text
            a(href=`mailto:${prismic.contactpage.data.email}`).contact__email=prismic.contactpage.data.email